{
  "name": "mini-ecommerce-platform",
  "version": "1.0.0",
  "description": "Full-stack E-Commerce Web Application with React, Node.js, Express, and MongoDB",
  "main": "backend/index.js",
  "scripts": {
    "start": "node backend/index.js",
    "backend": "npm --prefix backend start",
    "frontend": "npm --prefix frontend dev",
    "dev:backend": "npm --prefix backend dev",
    "dev:frontend": "npm --prefix frontend dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "build:frontend": "npm --prefix frontend run build",
    "seed": "npm --prefix backend run seed"
  },
  "keywords": [
    "react",
    "nodejs",
    "express",
    "mongodb",
    "ecommerce",
    "jwt-authentication",
    "tailwindcss",
    "vite"
  ],
  "author": "Full Stack Developer",
  "license": "ISC"
}
